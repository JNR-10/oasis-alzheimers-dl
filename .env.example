# Copy to .env and edit. .env is gitignored and must stay that way.
#
#   cp .env.example .env
#
# Every path here is local and machine-specific. Nothing in this file's real
# counterpart is ever committed, and no path should point inside the repository.

# Where your OASIS download lives. Read by configs/config.yaml as
# ${oc.env:OASIS_ROOT,./data}, so leaving it unset silently falls back to ./data
# and a run will look like it worked on an empty cohort.
#
# Point this OUTSIDE the repository. A cohort inside the working tree is one
# `git add -A` away from a Data Use Agreement violation, and the pre-commit size
# hook will not catch a file under 5 MB.
OASIS_ROOT=/absolute/path/to/oasis

# OASIS_ROOT is currently the only environment variable this project reads.
# results_dir and checkpoint_dir are set in configs/config.yaml, not here; override
# them on the command line instead:
#
#   python -m oasis_dl.cli.train paths.results_dir=/somewhere/else
